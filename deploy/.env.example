# Copy to .env (cp .env.example .env) and fill in. .env stays on the server only.

# The site's address: a name whose A record points at the server, such as app.me0.ai, or,
# with no domain, the server's public IP with dashes and .sslip.io, such as 129-146-1-2.sslip.io.
SITE_ADDRESS=app.me0.ai

# The domain every site's subdomain is under (roadmap R71a): anna.me0.ai and so on. The same as
# main_domain in config.toml. A record for *.me0.ai must point at the server (SUBDOMAINS.md).
MAIN_DOMAIN=me0.ai

# A Cloudflare API token that can edit me0.ai's DNS, so Caddy can get the *.me0.ai certificate
# (SUBDOMAINS.md, step 3). Like the password's hash, it stays in this file on the server.
CLOUDFLARE_API_TOKEN=paste.the.token.here

# The name and password the browser asks for. Make the hash with:
#   docker run --rm -it caddy:2 caddy hash-password
# and paste it between the single quotes, which keep its $ signs as they are.
LOGIN_NAME=larry
LOGIN_PASSWORD_HASH='$2a$14$paste.the.hash.here'

# A Hugging Face read token, so the person's own voice is spoken with Pocket TTS, fast enough
# that a reply has no long pauses (README.md here, step 6e). Leave it empty to use Chatterbox.
HF_TOKEN=
