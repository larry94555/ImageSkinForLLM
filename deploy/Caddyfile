# HTTPS and the password in front of the app (roadmap R32). Caddy gets and renews the
# certificates from Let's Encrypt by itself. The values come from .env.

# What every address serves: the default people's packs, then the app behind the password.
(site) {
	# The default people's packs (roadmap R32a), for Start now on any computer: made-up people,
	# so they are served without the password. Only the .zip files in default-people/ are sent.
	handle_path /default-people/* {
		@pack path_regexp ^/[a-z0-9_]+\.zip$
		handle @pack {
			root * /srv/default-people
			file_server
		}
		respond 404
	}
	# Stripe's events about subscriptions (roadmap R67), sent to the main address by Stripe's
	# servers, which have no password: the app checks each one's signature instead. Only the
	# main address has this path; at a subdomain the app answers Not found.
	handle /api/payments/stripe/events {
		reverse_proxy app:8000
	}
	handle {
		# One name and password for the rest of the site, asked for once by the browser, until
		# R71 removes it for the customers' sites.
		basic_auth {
			{$LOGIN_NAME} {$LOGIN_PASSWORD_HASH}
		}
		reverse_proxy app:8000 {
			# Send each part of a reply's video as soon as it is written (roadmap R22d).
			flush_interval -1
		}
	}
	log
}

# The main address, such as app.me0.ai, with its own certificate, as before.
{$SITE_ADDRESS} {
	import site
}

# Every site's own subdomain, such as anna.me0.ai (roadmap R61, R71a): one certificate for all
# of them, *.me0.ai, which Let's Encrypt gives only after a DNS check that Caddy does through
# Cloudflare's API (caddy/Dockerfile, docs/guides/Subdomain-Setup-Guide.md). The main address above is matched first.
*.{$MAIN_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# Ask Cloudflare's own resolver whether the check's record is there yet.
		resolvers 1.1.1.1
	}
	import site
}

# The same packs for the hosted app itself, over plain HTTP inside Docker only (no port of
# compose.yaml publishes 8090), so it doesn't depend on reaching its own public address.
:8090 {
	@pack path_regexp ^/[a-z0-9_]+\.zip$
	handle @pack {
		root * /srv/default-people
		file_server
	}
	respond 404
}
